# Скопируй в .env или запусти ./dealradar setup — он заполнит сам.

# Telegram: @BotFather → /newbot → скопировать токен
TELEGRAM_BOT_TOKEN=
# Твой chat_id: напиши боту /start, setup.py определит автоматически
TELEGRAM_CHAT_ID=

# Travelpayouts: travelpayouts.com → Инструменты → API → токен (бесплатно)
TRAVELPAYOUTS_TOKEN=
# Партнёрский маркер — необязательно, нужен только если хочешь кешбэк с покупок
TRAVELPAYOUTS_MARKER=
